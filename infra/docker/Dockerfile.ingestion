FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1

RUN pip install uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY shared/ ./shared/
COPY services/ingestion/ ./services/ingestion/

RUN uv sync --package faultatlas-ingestion --no-dev

CMD ["uv", "run", "--package", "faultatlas-ingestion", \
     "python", "-m", "app.main"]
