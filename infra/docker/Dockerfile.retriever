FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1

RUN pip install uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY shared/ ./shared/
COPY services/retriever/ ./services/retriever/

RUN uv sync --package faultatlas-retriever --no-dev

EXPOSE 8001

CMD ["uv", "run", "--package", "faultatlas-retriever", \
     "uvicorn", "app.main:app", "--app-dir", "services/retriever", "--host", "0.0.0.0", "--port", "8001"]
