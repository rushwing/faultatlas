FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1

RUN pip install uv

WORKDIR /app

# Copy workspace config and shared library first (better layer caching)
COPY pyproject.toml uv.lock* ./
COPY shared/ ./shared/
COPY services/api/ ./services/api/

# Install only this service's deps
RUN uv sync --package faultatlas-api --no-dev

EXPOSE 8000

CMD ["uv", "run", "--package", "faultatlas-api", \
     "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
